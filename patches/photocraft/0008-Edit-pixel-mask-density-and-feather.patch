+//! Properties for pixel layer masks.
+
+use photocraft_doc::LayerId;
+use serde_json::{Value, json};
+
+use crate::commands::CommandSpec;
+use crate::{EngineError, Result, Session};
+
+const EDIT: &str = "layer.layerMask.edit";
+
+fn bad(msg: impl Into<String>) -> EngineError {
+    EngineError::BadParams { cmd: EDIT.into(), msg: msg.into() }
+}
+
+fn has_doc(s: &Session) -> std::result::Result<(), String> {
+    s.active().map(|_| ()).ok_or_else(|| "no document open".into())
+}
+
+fn layer_id(s: &Session, p: &Value) -> Result<LayerId> {
+    match p.get("layer") {
+        Some(value) => value.as_u64().map(LayerId).ok_or_else(|| bad("`layer` must be a valid layer id")),
+        None => s.active().and_then(|state| state.active_layer).ok_or_else(|| EngineError::Other("no active layer".into())),
+    }
+}
+
+fn number(p: &Value, key: &str, min: f64, max: f64, unit: &str) -> Result<Option<f32>> {
+    let Some(value) = p.get(key) else { return Ok(None) };
+    let Some(value) = value.as_f64() else { return Err(bad(format!("`{key}` must be a finite number in {min}..={max} {unit}"))) };
+    if !value.is_finite() || !(min..=max).contains(&value) {
+        return Err(bad(format!("`{key}` = {value} is outside {min}..={max} {unit}")));
+    }
+    Ok(Some(value as f32))
+}
+
+fn edit(s: &mut Session, p: &Value) -> Result<Value> {
+    let Some(params) = p.as_object() else { return Err(bad("parameters must be an object")) };
+    if let Some(key) = params.keys().find(|key| !matches!(key.as_str(), "layer" | "density" | "feather" | "coalesce")) {
+        return Err(bad(format!("unknown parameter `{key}`")));
+    }
+    if p.get("coalesce").is_some_and(|value| !value.is_string()) {
+        return Err(bad("`coalesce` must be a string"));
+    }
+    let density = number(p, "density", 0.0, 100.0, "%")?.map(|value| value / 100.0);
+    let feather = number(p, "feather", 0.0, 1000.0, "px")?;
+    if density.is_none() && feather.is_none() {
+        return Err(bad("provide `density` or `feather`"));
+    }
+    let id = layer_id(s, p)?;
+    let current = s.active().ok_or(EngineError::NoDocument)?.doc.layer(id).ok_or(EngineError::NoLayer(id))?;
+    let mask = current.mask.as_ref().ok_or_else(|| EngineError::Other("layer has no layer mask".into()))?;
+    let next_density = density.unwrap_or(mask.density);
+    let next_feather = feather.unwrap_or(mask.feather);
+    if next_density == mask.density && next_feather == mask.feather {
+        return Ok(json!({"layer": id.0, "density": mask.density * 100.0, "feather": mask.feather}));
+    }
+
+    s.edit("Edit Layer Mask Properties", |doc, _| {
+        let layer = doc.layer_mut(id).ok_or(EngineError::NoLayer(id))?;
+        let mask = layer.mask.as_mut().ok_or_else(|| EngineError::Other("layer has no layer mask".into()))?;
+        if let Some(density) = density {
+            mask.density = density;
+        }
+        if let Some(feather) = feather {
+            mask.feather = feather;
+        }
+        Ok(())
+    })?;
+    Ok(json!({"layer": id.0, "density": next_density * 100.0, "feather": next_feather}))
+}
+
+pub fn specs() -> Vec<CommandSpec> {
+    vec![CommandSpec {
+        id: EDIT,
+        label: "Edit Layer Mask Properties",
+        menu: &[],
+        shortcut: None,
+        params: r##"{"layer":id? (default active),"density":0..100? (percent),"feather":0..1000? (px),"coalesce":str?} (provide density, feather or both)"##,
+        enabled: has_doc,
+        journal: true,
+        run: edit,
+    }]
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use photocraft_doc::LayerMask;
+    use photocraft_geom::Rect;
+    use serde_json::json;
+
+    fn session_with_mask(depth: u32) -> (Session, LayerId) {
+        let mut s = Session::new();
+        s.execute("file.new", json!({"width": 64, "height": 8, "depth": depth})).unwrap();
+        let id = LayerId(s.execute("layer.new.layer", json!({})).unwrap()["layer"].as_u64().unwrap());
+        s.edit("mask fixture", |doc, _| {
+            let bounds = doc.bounds();
+            let layer = doc.layer_mut(id).ok_or(EngineError::NoLayer(id))?;
+            layer.surface_mut().ok_or(EngineError::NoLayer(id))?.fill_rect(bounds, &[0.0, 0.0, 0.0, 1.0]);
+            let mut mask = LayerMask::reveal_all();
+            mask.surface.fill_rect(Rect::new(32, 0, 64, 8), &[0.0]);
+            layer.mask = Some(mask);
+            Ok(())
+        })
+        .unwrap();
+        (s, id)
+    }
+
+    fn properties(s: &Session, id: LayerId) -> (f32, f32) {
+        let mask = s.active().unwrap().doc.layer(id).unwrap().mask.as_ref().unwrap();
+        (mask.density, mask.feather)
+    }
+
+    fn pixel(s: &mut Session, x: i32) -> [f32; 4] {
+        serde_json::from_value(s.execute("document.pixel", json!({"x": x, "y": 4})).unwrap()).unwrap()
+    }
+
+    #[test]
+    fn edit_sets_both_mask_properties_in_one_undoable_step_and_skips_noops() {
+        let (mut s, id) = session_with_mask(8);
+        let history = s.active().unwrap().history.past_len();
+        s.execute(EDIT, json!({"layer": id.0, "density": 100, "feather": 0})).unwrap();
+        assert_eq!(s.active().unwrap().history.past_len(), history, "default values are a no-op");
+        s.execute(EDIT, json!({"layer": id.0, "density": 42.5, "feather": 8})).unwrap();
+        assert_eq!(properties(&s, id), (0.425, 8.0));
+        assert_eq!(s.active().unwrap().history.past_len(), history + 1);
+        assert!(s.undo());
+        assert_eq!(properties(&s, id), (1.0, 0.0));
+        assert_eq!(s.active().unwrap().doc.layer(id).unwrap().mask.as_ref().unwrap().surface.sample_channel(40, 4, 0), 0.0, "undo preserves the mask pixels");
+        assert!(s.redo());
+        assert_eq!(properties(&s, id), (0.425, 8.0));
+    }
+
+    #[test]
+    fn coalesced_property_updates_are_one_history_step() {
+        let (mut s, id) = session_with_mask(8);
+        let history = s.active().unwrap().history.past_len();
+        s.execute(EDIT, json!({"density": 50, "coalesce": "mask-properties"})).unwrap();
+        s.execute(EDIT, json!({"feather": 4, "coalesce": "mask-properties"})).unwrap();
+        assert_eq!(properties(&s, id), (0.5, 4.0));
+        assert_eq!(s.active().unwrap().history.past_len(), history + 1);
+        assert!(s.undo());
+        assert_eq!(properties(&s, id), (1.0, 0.0));
+    }
+
+    #[test]
+    fn edit_rejects_invalid_inputs_without_mutating_mask_or_history() {
+        let (mut s, id) = session_with_mask(8);
+        let history = s.active().unwrap().history.past_len();
+        for params in [
+            json!({}),
+            json!({"density": "50"}),
+            json!({"density": -0.1}),
+            json!({"density": 100.1}),
+            json!({"feather": -0.1}),
+            json!({"feather": 1000.1}),
+            json!({"feather": false}),
+            json!({"opacity": 0.5}),
+            json!({"layer": "bad", "density": 50}),
+            json!({"layer": 999999, "density": 50}),
+        ] {
+            assert!(s.execute(EDIT, params).is_err());
+            assert_eq!(properties(&s, id), (1.0, 0.0));
+            assert_eq!(s.active().unwrap().history.past_len(), history);
+        }
+    }
+
+    #[test]
+    fn explicit_target_and_missing_mask_are_handled_without_side_effects() {
+        let (mut s, masked) = session_with_mask(8);
+        let plain = LayerId(s.execute("layer.new.layer", json!({})).unwrap()["layer"].as_u64().unwrap());
+        assert!(s.execute(EDIT, json!({"layer": plain.0, "density": 50})).is_err());
+        assert_eq!(properties(&s, masked), (1.0, 0.0));
+        let history = s.active().unwrap().history.past_len();
+        s.execute(EDIT, json!({"layer": masked.0, "density": 50})).unwrap();
+        assert_eq!(properties(&s, masked), (0.5, 0.0));
+        assert_eq!(s.active().unwrap().active_layer, Some(plain), "explicit target keeps active layer");
+        assert_eq!(s.active().unwrap().history.past_len(), history + 1);
+        assert!(s.undo());
+        assert_eq!(s.active().unwrap().active_layer, Some(plain));
+        assert_eq!(properties(&s, masked), (1.0, 0.0));
+    }
+
+    #[test]
+    fn density_and_feather_affect_composition_at_each_pixel_depth() {
+        for depth in [8, 16, 32] {
+            let (mut s, id) = session_with_mask(depth);
+            assert!(pixel(&mut s, 60)[0] > 0.99, "hidden area starts as white at {depth}-bit");
+            s.execute(EDIT, json!({"density": 50})).unwrap();
+            assert!((pixel(&mut s, 60)[0] - 0.5).abs() < 0.03, "density reveals half at {depth}-bit");
+            s.execute(EDIT, json!({"density": 100, "feather": 8})).unwrap();
+            let left = pixel(&mut s, 31)[0];
+            let right = pixel(&mut s, 32)[0];
+            assert!(left > 0.3 && left < 0.5 && right > 0.5 && right < 0.7, "feather softens mask edge at {depth}-bit: {left}, {right}");
+            assert!(pixel(&mut s, 8)[0] < 0.01 && pixel(&mut s, 60)[0] > 0.99, "far pixels remain unchanged at {depth}-bit");
+            assert_eq!(s.active().unwrap().doc.layer(id).unwrap().mask.as_ref().unwrap().feather, 8.0);
+        }
+    }
+
+    #[test]
+    fn edited_mask_properties_roundtrip_through_psd() {
+        let (mut s, _) = session_with_mask(8);
+        s.execute(EDIT, json!({"density": 37.5, "feather": 6.25})).unwrap();
+        let psd = photocraft_io::document_to_psd(&s.active().unwrap().doc);
+        let bytes = psd.to_bytes().unwrap();
+        let parsed = photocraft_psd::PsdFile::from_bytes(&bytes).unwrap();
+        let (roundtrip, _) = photocraft_io::psd_to_document(&parsed);
+        let mask = roundtrip.walk().into_iter().map(|(_, _, layer)| layer).find(|layer| layer.name == "Layer 1").unwrap().mask.as_ref().unwrap();
+        assert!((mask.density - 0.375).abs() < 0.004, "PSD stores density as a byte: {}", mask.density);
+        assert!((mask.feather - 6.25).abs() < f32::EPSILON);
+    }
+}
