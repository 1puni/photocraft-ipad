diff --git a/crates/engine/src/layer_multi_cmds.rs b/crates/engine/src/layer_multi_cmds.rs
index 54e3c40..66acde2 100644
--- a/crates/engine/src/layer_multi_cmds.rs
+++ b/crates/engine/src/layer_multi_cmds.rs
@@ -196,6 +196,131 @@ fn bad(cmd: &str, msg: impl Into<String>) -> EngineError {
 
 // ---------- moving layers ----------
 
+/// `layer.moveTo`: reorder one legacy layer, or the explicitly supplied layer block, as one edit.
+pub fn move_to(s: &mut Session, p: &Value) -> Result<Value> {
+    const CMD: &str = "layer.moveTo";
+    let explicit = p.get("layers");
+    if explicit.is_some() && p.get("layer").is_some() {
+        return Err(bad(CMD, "use either `layer` or `layers`, not both"));
+    }
+    let (requested, explicit) = if let Some(value) = explicit {
+        let values = value.as_array().ok_or_else(|| bad(CMD, "`layers` must be an array of layer ids"))?;
+        if values.is_empty() {
+            return Err(bad(CMD, "`layers` must contain at least one layer id"));
+        }
+        let ids = values
+            .iter()
+            .enumerate()
+            .map(|(index, value)| value.as_u64().map(LayerId).ok_or_else(|| bad(CMD, format!("`layers[{index}]` = {value} is not a valid id"))))
+            .collect::<Result<Vec<_>>>()?;
+        (ids, true)
+    } else {
+        (vec![crate::commands::layer_param(s, p)?], false)
+    };
+    let target = LayerId(p.get("target").and_then(Value::as_u64).ok_or_else(|| bad(CMD, "`target` must be a valid layer id"))?);
+    let position = match p.get("position") {
+        None => "above",
+        Some(Value::String(position)) if matches!(position.as_str(), "above" | "below" | "into") => position,
+        Some(value) => return Err(bad(CMD, format!("`position` = {value} must be `above`, `below` or `into`"))),
+    };
+
+    let before = s.active().ok_or(EngineError::NoDocument)?.doc.clone();
+    let roots = normalized_move_roots(&before, &requested)?;
+    // A target chosen from any selected row is a deliberate no-op, including a selected child
+    // that normalization drops because its selected parent carries it.
+    if requested.contains(&target) {
+        if before.layer(target).is_none() {
+            return Err(EngineError::NoLayer(target));
+        }
+        return Ok(Value::Null);
+    }
+    let before_shape = layer_tree_shape(&before);
+    let mut after = (*before).clone();
+    reorder_layers(&mut after, &roots, target, position)?;
+    check_group_depth(&after, "Reorder Layers")?;
+    if layer_tree_shape(&after) == before_shape {
+        return Ok(Value::Null);
+    }
+
+    let legacy_active = roots.last().copied();
+    if explicit && let Some(state) = s.active_mut() {
+        state.history.set_current_layers(photocraft_ops::LayerTarget { active: state.active_layer, selected: state.selected_layers.clone() });
+    }
+    s.edit("Reorder Layers", |doc, active| {
+        *doc = after;
+        if !explicit {
+            *active = legacy_active;
+        }
+        Ok(())
+    })?;
+    Ok(Value::Null)
+}
+
+fn normalized_move_roots(doc: &Document, requested: &[LayerId]) -> Result<Vec<LayerId>> {
+    for id in requested {
+        if doc.layer(*id).is_none() {
+            return Err(EngineError::NoLayer(*id));
+        }
+    }
+    let mut unique = Vec::with_capacity(requested.len());
+    for id in requested {
+        if !unique.contains(id) {
+            unique.push(*id);
+        }
+    }
+    let roots = top_level(doc, &unique);
+    if roots.is_empty() {
+        return Err(EngineError::Other("no layer selected".into()));
+    }
+    Ok(roots)
+}
+
+fn layer_tree_shape(doc: &Document) -> Vec<(LayerId, Option<LayerId>)> {
+    doc.walk()
+        .into_iter()
+        .map(|(path, _, layer)| {
+            let parent = path.get(..path.len().saturating_sub(1)).and_then(|parent| doc.layer_at(parent)).map(|layer| layer.id);
+            (layer.id, parent)
+        })
+        .collect()
+}
+
+fn reorder_layers(doc: &mut Document, roots: &[LayerId], target: LayerId, position: &str) -> Result<()> {
+    let target_path = doc.path_of(target).ok_or(EngineError::NoLayer(target))?;
+    for root in roots {
+        let root_path = doc.path_of(*root).ok_or(EngineError::NoLayer(*root))?;
+        if target_path.starts_with(&root_path) {
+            return Err(EngineError::Other("can't move a layer relative to its descendant".into()));
+        }
+    }
+    if position == "into" && doc.layer(target).and_then(Layer::children).is_none() {
+        return Err(EngineError::Other("target is not a group".into()));
+    }
+
+    // All IDs, target relationships, and insertion destinations are checked before removal.
+    let mut moving = Vec::with_capacity(roots.len());
+    for id in roots {
+        moving.push((*id, doc.remove(*id).ok_or(EngineError::NoLayer(*id))?));
+    }
+    let target_path = doc.path_of(target).ok_or(EngineError::NoLayer(target))?;
+    if position == "into" {
+        let children = doc.layer_at_mut(&target_path).and_then(Layer::children_mut).ok_or_else(|| EngineError::Other("target is not a group".into()))?;
+        children.extend(moving.into_iter().map(|(_, layer)| layer));
+    } else {
+        let (&target_index, parent) = target_path.split_last().ok_or(EngineError::NoLayer(target))?;
+        let siblings = if parent.is_empty() {
+            &mut doc.layers
+        } else {
+            doc.layer_at_mut(parent).and_then(Layer::children_mut).ok_or_else(|| EngineError::Other("target's parent is not a group".into()))?
+        };
+        let insertion = if position == "below" { target_index } else { target_index.saturating_add(1) }.min(siblings.len());
+        for (offset, (_, layer)) in moving.into_iter().enumerate() {
+            siblings.insert(insertion.saturating_add(offset).min(siblings.len()), layer);
+        }
+    }
+    Ok(())
+}
+
 fn link_groups(doc: &Document, ids: &[LayerId]) -> Vec<u64> {
     let mut g: Vec<u64> = ids.iter().filter_map(|id| doc.layer(*id)?.link_group).collect();
     g.sort_unstable();
