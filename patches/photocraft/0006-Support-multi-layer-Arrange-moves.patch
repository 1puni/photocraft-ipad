+
+    fn group_layer(s: &mut Session, name: &str, children: Vec<Layer>) -> LayerId {
+        let group = Layer::group(name, children);
+        let id = group.id;
+        s.edit("test group", |doc, active| {
+            doc.insert_above(doc.top_layer(), group);
+            *active = Some(id);
+            Ok(())
+        })
+        .unwrap();
+        id
+    }
