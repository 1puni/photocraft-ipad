+    #[test]
+    fn move_to_reorders_a_block_in_document_order_above_below_and_into() {
+        let mut s = session(8);
+        let bg = doc(&s).layers[0].id;
+        let a = rect_layer(&mut s, Rect::new(0, 0, 1, 1));
+        let b = rect_layer(&mut s, Rect::new(0, 0, 1, 1));
+        let c = rect_layer(&mut s, Rect::new(0, 0, 1, 1));
+        let d = rect_layer(&mut s, Rect::new(0, 0, 1, 1));
+        let target = group_layer(&mut s, "Target", vec![]);
+        s.execute("layer.moveTo", json!({"layers": [d.0, b.0, d.0], "target": a.0, "position": "above"})).unwrap();
+        assert_eq!(tree(&s).iter().map(|(id, _)| *id).collect::<Vec<_>>(), vec![bg, a, b, d, c, target]);
+        s.execute("layer.moveTo", json!({"layers": [b.0, d.0], "target": c.0, "position": "below"})).unwrap();
+        assert_eq!(tree(&s).iter().map(|(id, _)| *id).collect::<Vec<_>>(), vec![bg, a, b, d, c, target]);
+        s.execute("layer.moveTo", json!({"layers": [d.0, b.0], "target": target.0, "position": "into"})).unwrap();
+        assert_eq!(tree(&s), vec![(bg, None), (a, None), (c, None), (target, None), (b, Some(target)), (d, Some(target))]);
+    }
+
+    #[test]
+    fn move_to_handles_cross_parent_roots_and_deduplicates_selected_ancestors() {
+        let mut s = session(8);
+        let bg = doc(&s).layers[0].id;
+        let child_a = Layer::raster("Child A", doc(&s).pixel_format());
+        let child_b = Layer::raster("Child B", doc(&s).pixel_format());
+        let child_a_id = child_a.id;
+        let child_b_id = child_b.id;
+        let group = group_layer(&mut s, "Group", vec![child_a, child_b]);
+        let outside = rect_layer(&mut s, Rect::new(0, 0, 1, 1));
+        let anchor = rect_layer(&mut s, Rect::new(0, 0, 1, 1));
+        s.execute("layer.moveTo", json!({"layers": [child_a_id.0, outside.0, group.0, child_b_id.0], "target": anchor.0, "position": "above"})).unwrap();
+        assert_eq!(tree(&s), vec![(bg, None), (anchor, None), (group, None), (child_a_id, Some(group)), (child_b_id, Some(group)), (outside, None)]);
+        // A target that was explicitly selected is a no-op, even when it is a selected child
+        // that gets subsumed by its selected ancestor during normalization.
+        let before = tree(&s);
+        let history = s.active().unwrap().history.entries().len();
+        s.execute("layer.moveTo", json!({"layers": [group.0, child_a_id.0], "target": child_a_id.0})).unwrap();
+        assert_eq!(tree(&s), before);
+        assert_eq!(s.active().unwrap().history.entries().len(), history);
+    }
+
+    #[test]
+    fn move_to_preserves_explicit_selection_and_undo_redo_restores_tree_and_target() {
+        let mut s = session(8);
+        let bg = doc(&s).layers[0].id;
+        let a = rect_layer(&mut s, Rect::new(0, 0, 1, 1));
+        let b = rect_layer(&mut s, Rect::new(0, 0, 1, 1));
+        let target = rect_layer(&mut s, Rect::new(0, 0, 1, 1));
+        set_selection(&mut s, vec![a, b], Some(a), Some(b)).unwrap();
+        let before = tree(&s);
+        let count = s.active().unwrap().history.entries().len();
+        s.execute("layer.moveTo", json!({"layers": [a.0, b.0], "target": target.0, "position": "above"})).unwrap();
+        assert_eq!(tree(&s), vec![(bg, None), (target, None), (a, None), (b, None)]);
+        assert_eq!(s.active().unwrap().active_layer, Some(a));
+        assert_eq!(sel(&s), vec![a, b]);
+        assert_eq!(s.active().unwrap().history.entries().len(), count + 1);
+        assert!(s.undo());
+        assert_eq!(tree(&s), before);
+        assert_eq!(s.active().unwrap().active_layer, Some(a));
+        assert_eq!(sel(&s), vec![a, b]);
+        assert!(s.redo());
+        assert_eq!(tree(&s), vec![(bg, None), (target, None), (a, None), (b, None)]);
+        assert_eq!(s.active().unwrap().active_layer, Some(a));
+        assert_eq!(sel(&s), vec![a, b]);
+    }
+
+    #[test]
+    fn move_to_rejects_bad_inputs_and_cycles_without_touching_document_or_history() {
+        let mut s = session(8);
+        let child = Layer::raster("Child", doc(&s).pixel_format());
+        let child_id = child.id;
+        let group = group_layer(&mut s, "Group", vec![child]);
+        let other = rect_layer(&mut s, Rect::new(0, 0, 1, 1));
+        let before = tree(&s);
+        let history = s.active().unwrap().history.entries().len();
+        for params in [
+            json!({"layers": [], "target": other.0}),
+            json!({"layers": "bad", "target": other.0}),
+            json!({"layers": ["bad"], "target": other.0}),
+            json!({"layers": [-1], "target": other.0}),
+            json!({"layers": [999999], "target": other.0}),
+            json!({"layers": [other.0], "layer": other.0, "target": group.0}),
+            json!({"layers": [other.0], "target": other.0, "position": 9}),
+            json!({"layers": [other.0], "target": other.0, "position": "sideways"}),
+            json!({"layers": [other.0], "target": 999999}),
+        ] {
+            assert!(s.execute("layer.moveTo", params).is_err());
+            assert_eq!(tree(&s), before);
+            assert_eq!(s.active().unwrap().history.entries().len(), history);
+        }
+        assert!(s.execute("layer.moveTo", json!({"layers": [group.0], "target": child_id.0, "position": "into"})).is_err());
+        assert_eq!(tree(&s), before);
+        assert_eq!(s.active().unwrap().history.entries().len(), history);
+    }
+
+    #[test]
+    fn move_to_rejects_group_depth_overflow_atomically() {
+        let mut s = session(8);
+        let mut nested = Layer::raster("Deep leaf", doc(&s).pixel_format());
+        let mut target = LayerId(0);
+        for depth in 0..photocraft_doc::MAX_GROUP_DEPTH {
+            let group = Layer::group(format!("Nested {depth}"), vec![nested]);
+            if depth == 0 {
+                target = group.id;
+            }
+            nested = group;
+        }
+        let source_child = Layer::raster("Source child", doc(&s).pixel_format());
+        let source = Layer::group("Source", vec![source_child]);
+        let source_id = source.id;
+        s.edit("deep fixture", |doc, active| {
+            doc.layers.push(nested);
+            doc.layers.push(source);
+            *active = Some(source_id);
+            Ok(())
+        })
+        .unwrap();
+        assert_eq!(doc(&s).max_group_depth(), photocraft_doc::MAX_GROUP_DEPTH);
+        let before = tree(&s);
+        let history = s.active().unwrap().history.entries().len();
+        assert!(s.execute("layer.moveTo", json!({"layers": [source_id.0], "target": target.0, "position": "into"})).is_err());
+        assert_eq!(tree(&s), before);
+        assert_eq!(s.active().unwrap().history.entries().len(), history);
+    }
+
+    #[test]
+    fn move_to_keeps_legacy_active_layer_semantics_and_skips_already_in_place_blocks() {
+        let mut s = session(8);
+        let bg = doc(&s).layers[0].id;
+        let a = rect_layer(&mut s, Rect::new(0, 0, 1, 1));
+        let b = rect_layer(&mut s, Rect::new(0, 0, 1, 1));
+        let target = rect_layer(&mut s, Rect::new(0, 0, 1, 1));
+        set_selection(&mut s, vec![a, b], Some(b), Some(a)).unwrap();
+        let history = s.active().unwrap().history.entries().len();
+        s.execute("layer.moveTo", json!({"layers": [a.0, b.0], "target": target.0, "position": "above"})).unwrap();
+        assert_eq!(tree(&s), vec![(bg, None), (target, None), (a, None), (b, None)]);
+        assert_eq!(s.active().unwrap().active_layer, Some(b));
+        let count = s.active().unwrap().history.entries().len();
+        // The block is already immediately above the target; this must not create a history step.
+        s.execute("layer.moveTo", json!({"layers": [a.0, b.0], "target": target.0, "position": "above"})).unwrap();
+        assert_eq!(s.active().unwrap().history.entries().len(), count);
+        s.execute("layer.moveTo", json!({"layer": a.0, "target": a.0})).unwrap();
+        assert_eq!(s.active().unwrap().active_layer, Some(b));
+        assert_eq!(s.active().unwrap().history.entries().len(), count);
+        s.execute("layer.moveTo", json!({"target": a.0, "position": "below"})).unwrap();
+        assert_eq!(tree(&s), vec![(bg, None), (target, None), (b, None), (a, None)]);
+        assert_eq!(s.active().unwrap().active_layer, Some(b), "omitted `layer` moves the active layer");
+        s.execute("layer.moveTo", json!({"layer": a.0, "target": bg.0, "position": "below"})).unwrap();
+        assert_eq!(s.active().unwrap().active_layer, Some(a));
+        assert_eq!(s.active().unwrap().history.entries().len(), count + 2);
+        assert!(history < count);
+    }
