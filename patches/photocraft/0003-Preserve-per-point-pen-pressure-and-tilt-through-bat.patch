diff --git a/crates/ui-egui/src/paint_mouse.rs b/crates/ui-egui/src/paint_mouse.rs
index 69fdb96..8f0e3de 100644
--- a/crates/ui-egui/src/paint_mouse.rs
+++ b/crates/ui-egui/src/paint_mouse.rs
@@ -450,4 +450,46 @@ mod tests {
         press(&mut h, end, PointerButton::Primary, false);
         assert_committed_points(&h, &queued);
     }
+
+    #[test]
+    fn one_frame_preserves_each_pen_points_pressure_and_tilt() {
+        let mut h = harness(None);
+        let a = h.state().last_canvas_rect.center() - vec2(90.0, 0.0);
+        h.event(egui::Event::PointerMoved(a));
+        h.run_steps(1);
+        press(&mut h, a, PointerButton::Primary, true);
+        h.event(egui::Event::PointerMoved(a + vec2(20.0, 0.0)));
+        h.run_steps(1);
+        let samples = [(0.15f32, 10.0f32), (0.5, 35.0), (0.9, 60.0)];
+        let mut end = a;
+        for (i, (pressure, tilt_x)) in samples.iter().copied().enumerate() {
+            end = a + vec2(30.0 + i as f32 * 12.0, 0.0);
+            h.state().stylus.feed.push(end, crate::stylus::PenSample { pressure, tilt_x, ..Default::default() });
+            h.input_mut().events.push(egui::Event::PointerMoved(end));
+        }
+        h.run_steps(1);
+        press(&mut h, end, PointerButton::Primary, false);
+        let strokes = strokes(&h);
+        assert_eq!(strokes.len(), 1);
+        let points = strokes[0]["points"].as_array().unwrap();
+        for (pressure, tilt) in samples {
+            assert!(
+                points.iter().any(|point| point[2].as_f64() == Some(pressure as f64) && point[3].as_f64() == Some(tilt as f64)),
+                "missing {pressure}/{tilt} in {points:?}"
+            );
+        }
+    }
+
+    #[test]
+    fn a_pen_tap_keeps_its_pressure() {
+        let mut h = harness(None);
+        let p = h.state().last_canvas_rect.center();
+        h.state().stylus.feed.push(p, crate::stylus::PenSample { pressure: 0.2, ..Default::default() });
+        h.event(egui::Event::PointerMoved(p));
+        press(&mut h, p, PointerButton::Primary, true);
+        press(&mut h, p, PointerButton::Primary, false);
+        let strokes = strokes(&h);
+        assert_eq!(strokes.len(), 1);
+        assert_eq!(strokes[0]["points"][0][2].as_f64(), Some(0.2f32 as f64));
+    }
 }
diff --git a/crates/ui-egui/src/stylus.rs b/crates/ui-egui/src/stylus.rs
index 6be50d7..62d7c63 100644
--- a/crates/ui-egui/src/stylus.rs
+++ b/crates/ui-egui/src/stylus.rs
@@ -26,6 +26,7 @@
 //! Automation simulates a pen with `ui.pointer` events carrying `pressure`, `tiltX`, `tiltY`
 //! and `rotation`.
 
+use std::collections::VecDeque;
 use std::sync::{Arc, Mutex};
 
 /// One stylus reading. Tilt is in degrees (-90..90, W3C Pointer Events convention), rotation in
@@ -64,16 +65,57 @@ impl PenSample {
 /// Shared slot a platform backend writes the current pen sample into (`None` = no pen down).
 /// Cloning shares the slot.
 #[derive(Clone, Debug, Default)]
-pub struct StylusFeed(Arc<Mutex<Option<PenSample>>>);
+pub struct StylusFeed(Arc<Mutex<FeedState>>);
+
+#[derive(Clone, Debug, Default)]
+struct FeedState {
+    current: Option<PenSample>,
+    points: VecDeque<(egui::Pos2, PenSample)>,
+}
 
 impl StylusFeed {
     pub fn set(&self, s: Option<PenSample>) {
         if let Ok(mut g) = self.0.lock() {
-            *g = s.map(PenSample::sanitized);
+            g.current = s.map(PenSample::sanitized);
+            if s.is_none() {
+                g.points.clear();
+            }
         }
     }
     pub fn get(&self) -> Option<PenSample> {
-        self.0.lock().ok().and_then(|g| *g)
+        self.0.lock().ok().and_then(|g| g.current)
+    }
+    /// Position-aligned samples from browser Pointer Events, in egui screen points.
+    /// Bounded even when a platform sends input while rendering is suspended.
+    pub fn push(&self, position: egui::Pos2, sample: PenSample) {
+        if !position.is_finite() {
+            return;
+        }
+        if let Ok(mut g) = self.0.lock() {
+            if g.points.len() >= 4096 {
+                g.points.pop_front();
+            }
+            let sample = sample.sanitized();
+            g.current = Some(sample);
+            g.points.push_back((position, sample));
+        }
+    }
+    pub fn clear_points(&self) {
+        if let Ok(mut g) = self.0.lock() {
+            g.points.clear();
+        }
+    }
+    /// Select the matching sample immediately before a tool consumes that movement.
+    /// Native backends without position samples continue using the current platform feed.
+    pub fn use_at(&self, position: egui::Pos2) {
+        if let Ok(mut g) = self.0.lock()
+            && let Some(index) = g.points.iter().position(|(p, _)| p.distance_sq(position) < 0.01)
+        {
+            if let Some((_, sample)) = g.points.get(index).copied() {
+                g.current = Some(sample);
+            }
+            g.points.drain(..=index);
+        }
     }
 }
 
