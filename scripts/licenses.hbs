<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>PhotoCraft iPad — dependency licenses</title>
<style>body{max-width:72ch;margin:3rem auto;padding:0 1rem;font:16px/1.5 system-ui}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.5 monospace}section{border-top:1px solid #aaa;margin-top:3rem}a{overflow-wrap:anywhere}</style></head><body>
<h1>Dependency licenses</h1>
<p>Generated from the locked WebAssembly dependency graph with cargo-about.
Includes build dependencies; development-only dependencies are excluded.
PhotoCraft's separate asset notices are in <a href="ATTRIBUTION.md">ATTRIBUTION.md</a>.</p>
{{#each licenses}}
<section><h2>{{name}}</h2><ul>
{{#each used_by}}<li>{{crate.name}} {{crate.version}}{{#if crate.repository}} — <a href="{{crate.repository}}">source</a>{{/if}}</li>{{/each}}
</ul><pre>{{text}}</pre></section>
{{/each}}
</body></html>
